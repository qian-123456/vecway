{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Vecway",
	"version": "0.2.0",
	"identifier": "ai.omp.workspace",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1421",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "Vecway",
				"width": 1440,
				"height": 900,
				"minWidth": 760,
				"minHeight": 480,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$HOME/.omp/agent/blobs/**", "$APPCACHE/ompws-clip/**", "$HOME/.vecway/images/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"publisher": "Hairui Qian",
		"copyright": "Copyright © 2026 Hairui Qian",
		"category": "DeveloperTool",
		"shortDescription": "Native desktop workbench and intelligent router for oh-my-pi (omp)",
		"longDescription": "Vecway is a native macOS desktop workbench for oh-my-pi (omp) agent sessions, featuring live session sync, Git worktree isolation, inline diff review, built-in terminal, token breakdown, and mobile remote access.",
		"macOS": {
			"entitlements": "Entitlements.plist",
			"hardenedRuntime": true,
			"minimumSystemVersion": "12.0",
			"dmg": {
				"appPosition": {
					"x": 180,
					"y": 170
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 170
				},
				"windowSize": {
					"width": 660,
					"height": 400
				}
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEJDNUFBRUJBRTNCRkEKUldUNk82N3Jxc1dMcmZtQzRucWpQaHRmY3NEUEthaHRHRitPT2VuazUvVytGbFczS1RqSGRFc2QK",
			"endpoints": [
				"https://github.com/qian-123456/vecway/releases/latest/download/latest.json"
			]
		}
	}
}
